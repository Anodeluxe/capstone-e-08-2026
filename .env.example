# ─────────────────────────────────────────────────────────────────────────────
# Toren Monitoring — Environment untuk Docker Compose
#
# File ini dipakai oleh docker-compose untuk substitusi variabel ($VAR) dan
# sebagai build-arg untuk image frontend.
#
# Salin ke `.env` lalu isi nilainya:
#   cp .env.example .env
#
# `.env` sudah masuk .gitignore — JANGAN di-commit.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (TimescaleDB) ───────────────────────────────────────────────────
POSTGRES_DB=toren_db
POSTGRES_USER=postgres
# WAJIB diganti di produksi. Generate: openssl rand -hex 24
POSTGRES_PASSWORD=ganti-dengan-password-kuat

# ── App ──────────────────────────────────────────────────────────────────────
# "development" → endpoint /docs (Swagger) tetap aktif
# "production"  → /docs dimatikan
APP_ENV=production

# ── URL publik frontend → backend ────────────────────────────────────────────
# PENTING: NEXT_PUBLIC_* di-inline Next.js saat `next build`.
# Mengubah nilai di sini ⇒ WAJIB rebuild image frontend
# (docker compose --profile app up -d --build frontend).
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# ── CORS ─────────────────────────────────────────────────────────────────────
# Origin frontend yang diizinkan (tanpa trailing slash, pisahkan dengan koma).
ALLOWED_ORIGINS=http://localhost:3000
